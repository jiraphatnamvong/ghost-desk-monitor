// Copy this file to secrets.h (same folder). secrets.h is in .gitignore: never commit it.
#pragma once

// The same phone hotspot the nodes join
#define WIFI_SSID "your-hotspot-name"
#define WIFI_PASS "your-hotspot-password"

// Supabase: Project Settings -> API. Use the anon (public) key, never the service_role key.
#define SUPABASE_URL      "https://your-project.supabase.co"
#define SUPABASE_ANON_KEY "your-anon-key"

// Discord: your server -> Server Settings -> Integrations -> Webhooks -> New Webhook -> pick the channel
// -> Copy Webhook URL. It is a secret: anyone who has it can post in the channel. Never commit it.
#define DISCORD_WEBHOOK_URL "https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"

// Claude API key for the desk-photo check (console.anthropic.com -> API keys)
#define ANTHROPIC_API_KEY "your-anthropic-api-key"

// Updates over Wi-Fi (E6): the password Arduino IDE asks for when you upload to the board's network port.
// Delete this line to turn updates over Wi-Fi off.
#define OTA_PASSWORD "choose-a-password"
